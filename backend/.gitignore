# ========================
# Backend .gitignore
# ========================

# ---------- Environment & Secrets ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# ---------- Database ----------
*.db
*.sqlite3

# ---------- Uploads & Exports (user data) ----------
data/uploads/*
data/exports/*
!data/uploads/.gitkeep
!data/exports/.gitkeep

# ---------- Testing ----------
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---------- Distribution ----------
dist/
build/
*.egg-info/
*.egg

# ---------- IDE ----------
.vscode/
.idea/
