# ─── Nirnay Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Groq LLM API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Model to use (llama-3.3-70b-versatile recommended — 131K context)
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Database — SQLite for dev/prod (path must be inside a Docker volume for persistence)
DATABASE_URL=sqlite:///./data/db/nirnay.db

# Storage backend: "local" or "gcs"
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads
EXPORTS_PATH=./data/exports

# Firebase project ID (for auth token verification)
FIREBASE_PROJECT_ID=your_firebase_project_id_here
